# --- PostgreSQL (local infra via infra/compose.yaml) ---
DATABASE_URL=postgresql://kong_dashboard:kong_dashboard@localhost:5433/kong_dashboard

# --- Kong Admin API ---
KONG_ADMIN_URL=http://localhost:8001
KONG_ADMIN_TOKEN=

# --- Redis (local infra) ---
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Local JWT auth (RS256) ---
# Generate a key pair with: bun run keys:generate
JWT_PRIVATE_KEY_PATH=./jwt-private.pem
JWT_PUBLIC_KEY_PATH=./jwt-public.pem
# Alternatively provide PEM contents inline (overrides the paths above):
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...
JWT_ISSUER=api-platform-dashboard
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- App ---
PORT=4000