    "@prisma/client": "^5.19.0",
    "@shared": "*",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
