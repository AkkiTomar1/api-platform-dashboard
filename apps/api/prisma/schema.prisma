generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceConsumerStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String
  firstName    String
  lastName     String
  avatarUrl    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roleAssignments RoleAssignment[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RoleAssignment {
  id           String  @id @default(cuid())
  userId       String
  role         String
  resourceId   String?
  resourceType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, resourceId, resourceType])
  @@index([userId])
  @@index([resourceId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actor        String
  ipAddress    String?
  resourceType String
  resourceName String
  userId       String
  beforeJson   Json?
  afterJson    Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceType])
  @@index([createdAt])
}

model GatewayService {
  id          String   @id @default(uuid())
  name        String
  description String
  kongName    String
  tags        Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceConsumers ServiceConsumer[]

  @@index([name])
}

model KongConsumer {
  id        String   @id @default(cuid())
  username  String?
  customId  String?
  createdAt DateTime @default(now())

  serviceConsumers ServiceConsumer[]

  @@index([username])
}

model ServiceConsumer {
  id         String              @id @default(cuid())
  serviceId  String
  consumerId String
  status     ServiceConsumerStatus @default(ACTIVE)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  service  GatewayService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  consumer KongConsumer   @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, consumerId])
}
